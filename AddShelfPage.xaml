<?xml version="1.0" encoding="utf-8" ?>
<!--
  A simple page that allows the user to add a new shelf number to the
  repository. It consists of an entry field for the shelf number and
  a button to submit. A message label provides feedback about the
  operation. -->
<ContentPage
    x:Class="ShelfApp.AddShelfPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add Shelf">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Enter Shelf Number" FontAttributes="Bold" FontSize="Medium" />
            <Entry x:Name="ShelfEntry" Placeholder="Shelf Number" Keyboard="Text" />
            <Button Text="Add Shelf" Clicked="OnAddShelfClicked" />
            <Label x:Name="MessageLabel" TextColor="Green" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>