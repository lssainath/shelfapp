<?xml version="1.0" encoding="utf-8" ?>
<!--
  Page that displays all shelves in a list format with Material Design styling.
  Each shelf shows its number, description, and item count.
-->
<ContentPage
    x:Class="ShelfApp.SearchByShelfPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Shelves"
    BackgroundColor="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Frame Grid.Row="0" 
               BackgroundColor="#2196F3"
               Padding="20,16"
               Margin="0,0,0,8"
               HasShadow="True">
            <StackLayout>
                <Label Text="Shelves" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label x:Name="ShelfCountLabel" 
                       Text="Loading shelves..." 
                       FontSize="14" 
                       TextColor="White"
                       HorizontalOptions="Center"
                       Opacity="0.8" />
            </StackLayout>
        </Frame>

        <!-- Search Section -->
        <Frame Grid.Row="1" 
               BackgroundColor="White"
               Padding="16"
               Margin="16,0,16,8"
               HasShadow="True"
               CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Entry Grid.Column="0"
                       x:Name="SearchEntry"
                       Placeholder="Search for an item..."
                       FontSize="16"
                       TextChanged="OnSearchTextChanged"
                       ClearButtonVisibility="WhileEditing" />
                       
                <Button Grid.Column="1"
                        Text="Clear"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        FontSize="12"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        Clicked="OnClearSearchClicked" />
            </Grid>
        </Frame>

        <!-- Shelves List -->
        <CollectionView Grid.Row="2" 
                        x:Name="ShelvesCollectionView"
                        BackgroundColor="Transparent"
                        Margin="16,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White"
                           Padding="0"
                           Margin="0,0,0,8"
                           HasShadow="True"
                           CornerRadius="12">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShelfTapped" CommandParameter="{Binding}" />
                        </Frame.GestureRecognizers>
                        <Grid Padding="20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Shelf Number -->
                            <Label Grid.Row="0" 
                                   Grid.Column="0"
                                   Text="{Binding ShelfNumber}" 
                                   FontSize="20" 
                                   FontAttributes="Bold"
                                   TextColor="#2196F3" />

                            <!-- Item Count Badge -->
                            <Frame Grid.Row="0" 
                                   Grid.Column="1"
                                   BackgroundColor="#2196F3"
                                   Padding="12,6"
                                   CornerRadius="16"
                                   HasShadow="False">
                                <Label Text="{Binding Items.Count, StringFormat='{0} items'}" 
                                       FontSize="12" 
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Frame>

                            <!-- Description -->
                            <Label Grid.Row="1" 
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Description}" 
                                   FontSize="14" 
                                   TextColor="#757575"
                                   Margin="0,4,0,0" />

                            <!-- Items Preview -->
                            <Label Grid.Row="2" 
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   x:Name="ItemsPreviewLabel"
                                   FontSize="12" 
                                   TextColor="#9E9E9E"
                                   Margin="0,8,0,0"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                    <Label Text="📦" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No shelves found" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,16,0,8" />
                    <Label Text="Add some shelves to get started!" 
                           FontSize="14" 
                           HorizontalOptions="Center"
                           TextColor="#757575" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Loading Indicator -->
        <ActivityIndicator x:Name="LoadingIndicator" 
                          Grid.Row="2"
                          IsRunning="True"
                          Color="#2196F3"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />

        <!-- Floating Action Button -->
        <Frame Grid.Row="2"
               BackgroundColor="#2196F3"
               WidthRequest="56"
               HeightRequest="56"
               CornerRadius="28"
               HasShadow="True"
               Padding="0"
               HorizontalOptions="End"
               VerticalOptions="End"
               Margin="16,16,16,32">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddShelfClicked" />
            </Frame.GestureRecognizers>
            <Label Text="+"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Frame>
    </Grid>
</ContentPage>