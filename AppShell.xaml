<?xml version="1.0" encoding="UTF-8" ?>
<!--
  This file defines the Shell for the application. The Shell provides a
  flyout menu containing navigation links to each page. Each FlyoutItem
  corresponds to a page used by the app. You can customise the
  appearance of the flyout by setting properties on the Shell or
  FlyoutItems.
-->
<Shell
    x:Class="ShelfApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ShelfApp"
    Title="Shelf App">

    <!-- Define a FlyoutItem for each page in the app. Users can select
         these from the navigation drawer to navigate. -->
    <FlyoutItem Title="Add Shelf">
        <ShellContent ContentTemplate="{DataTemplate local:AddShelfPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Add Item">
        <ShellContent ContentTemplate="{DataTemplate local:AddItemPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Search by Shelf">
        <ShellContent ContentTemplate="{DataTemplate local:SearchByShelfPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Search by Item">
        <ShellContent ContentTemplate="{DataTemplate local:SearchByItemPage}" />
    </FlyoutItem>

</Shell>